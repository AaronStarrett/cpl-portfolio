---
import { sitePath } from "../data/paths";
import "../styles/global.css";
import "../styles/explorers.css";
import "../styles/story-polish.css";
import "../styles/brand-depth.css";
import "../styles/case-depth.css";
const {
  title = "Cyber Pirate Labs — Selected work",
  description = "Process improvement, workflow automation, custom operational software, and digital workforce design by Aaron Starrett.",
  image = "/images/social-preview.png",
} = Astro.props;
const origin = Astro.site;
const published = origin && origin.hostname !== "localhost";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{title}</title><meta
      name="description"
      content={description}
    /><meta name="theme-color" content="#ffffff" /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content="website"
    />{
      published && (
        <>
          <>
            <link rel="canonical" href={new URL(Astro.url.pathname, origin)} />
            <meta
              property="og:url"
              content={new URL(Astro.url.pathname, origin)}
            />
            <meta
              property="og:image"
              content={new URL(sitePath(image), origin)}
            />
            <meta name="twitter:card" content="summary_large_image" />
          </>
        </>
      )
    }<link
      rel="icon"
      type="image/svg+xml"
      href={sitePath("/favicon.svg")}
    /></head
  ><body
    ><a class="skip-link" href="#main">Skip to content</a><header
      class="site-header"
    >
      <a
        class="wordmark"
        href={sitePath("/")}
        aria-label="Cyber Pirate Labs home"
        ><img
          class="brand-artwork"
          src={sitePath("/images/cpl-shield.png")}
          width="830"
          height="595"
          alt="Cyber Pirate Labs shield"
        /><span>CYBER PIRATE LABS<small>BUILD WITH INTENT.</small></span></a
      ><nav aria-label="Main navigation">
        <a href={sitePath("/#work")}>Selected work</a><a
          class="contact-link"
          href="mailto:Sales@CyberPirateLabs.com">Let's talk <span>↗</span></a
        >
      </nav>
    </header><main id="main"><slot /></main><footer class="site-footer">
      <a class="wordmark" href={sitePath("/")}
        ><img
          class="brand-artwork"
          src={sitePath("/images/cpl-shield.png")}
          width="830"
          height="595"
          alt="Cyber Pirate Labs shield"
        /><span
          >CYBER PIRATE LABS<small>Designed & built by Aaron Starrett</small
          ></span
        ></a
      ><span>Thoughtful systems. Practical possibilities.</span><a
        href="mailto:Sales@CyberPirateLabs.com">Start a conversation ↗</a
      >
    </footer></body
  >
</html>
